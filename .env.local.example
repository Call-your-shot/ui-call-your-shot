# Copy this file to .env.local and fill in your key.
# .env.local is already gitignored — never commit real keys.

# Server-only. Do NOT prefix with NEXT_PUBLIC_ — the key must never reach
# the browser. All Solar API calls go through app/api/solar/route.ts and
# app/api/solar-image/route.ts, which run server-side.
#
# Enable these APIs in Google Cloud Console for this key:
#   - Solar API
#   - Geocoding API
#   - Maps Static API
GOOGLE_MAPS_API_KEY=

# Server-only. Powers /api/bill (reading an uploaded electricity bill photo
# or PDF) via Gemini's vision input. Get a key from Google AI Studio
# (https://aistudio.google.com/apikey) — a different product/key from the
# Google Maps key above. Without this set, bill scanning is skipped and
# users fall back to entering their address + usage manually.
GEMINI_API_KEY=
